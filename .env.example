# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Stripe keys are TEST MODE ONLY (sk_test_...). No real money, no credit card, ever.

# SQLite file location (created automatically)
DATABASE_PATH=./data/app.db

# Stripe test-mode secret key (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_paste_yours_here

# Webhook signing secret from `stripe listen` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_paste_yours_here

# Stripe Price ID for the Pro plan (test mode, recurring $20/month)
STRIPE_PRO_PRICE_ID=price_paste_yours_here

# Background-job interval in seconds (usage alerts + reconciliation)
JOB_INTERVAL_SECONDS=300

APP_HOST=127.0.0.1
APP_PORT=8000
